<view class="safe">
  <view wx:if="{{needLogin}}" class="card login-card">
    <view class="h2">登录后查看订单</view>
    <view class="sub mt-8">下单、取件和补差都会出现在这里。</view>
    <view class="btn" bindtap="doLogin">登录</view>
  </view>
  <block wx:else>
    <scroll-view class="tabs" scroll-x>
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{tab===item.key?'on':''}}"
        data-tab="{{item.key}}"
        bindtap="switchTab"
      >{{item.label}}</view>
    </scroll-view>
    <view wx:if="{{!list.length}}" class="empty card">该分类暂无订单</view>
    <view class="card order" wx:for="{{list}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
      <view class="avatar ph" wx:if="{{!item.cover}}">宠</view>
      <image wx:else class="avatar" src="{{item.cover}}" mode="aspectFill" />
      <view class="meta">
        <view class="top">
          <view class="pet">{{item.title}}</view>
          <view class="st {{item.statusClass}}">{{item.statusText}}</view>
        </view>
        <view class="path">{{item.path}}</view>
        <view class="bot">
          <text class="faint">{{item.subline}}</text>
          <text class="price">¥{{item.paidYuan}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

