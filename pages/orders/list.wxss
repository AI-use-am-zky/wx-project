page { background: #f3efe8; color: #15241e; }

.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: #2d5a4a;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.top-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.back {
  width: 56rpx;
  height: 72rpx;
  flex-shrink: 0;
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 72rpx;
}
.search {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-ico {
  width: 36rpx;
  color: #999;
  font-size: 24rpx;
}
.search-input { flex: 1; font-size: 28rpx; height: 72rpx; }
.search-ph { color: #b0b0b0; }
.tabs { height: 88rpx; }
.tab-row { white-space: nowrap; }
.tab {
  display: inline-block;
  padding: 24rpx 22rpx 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.72);
}
.tab.on { color: #fff; font-weight: 700; }
.count { font-weight: 700; }

.empty-box { padding: 120rpx 48rpx; text-align: center; }
.empty-title { font-size: 30rpx; color: #666; }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: #999; }
.login-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #1e4d3e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.bill {
  margin: 16rpx 20rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx 16rpx;
}
.bill-no {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #999;
}
.copy { color: #2d6a55; }
.route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0 8rpx;
}
.city-col { flex: 1; min-width: 0; }
.city-col.right { text-align: right; }
.place {
  font-size: 40rpx;
  font-weight: 700;
  color: #15241e;
  line-height: 1.2;
}
.when { margin-top: 8rpx; font-size: 22rpx; color: #999; }
.arrow { color: #ccc; font-size: 28rpx; flex-shrink: 0; }
.face {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f2;
}
.face-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2d6a55;
  font-size: 24rpx;
  font-weight: 700;
}
.status {
  font-size: 26rpx;
  font-weight: 650;
  flex-shrink: 0;
}
.status.go { color: #2d6a55; }
.status.done { color: #8a918c; }
.status.wait { color: #c45a28; }
.ops {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 8rpx;
}
.op {
  padding: 8rpx 18rpx;
  border: 1rpx solid #c5d6cd;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1e4d3e;
  background: #fff;
}
.list-end {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 28rpx 0 48rpx;
}
