.home-swiper {
  width: 100%;
  height: 375rpx;
}
.slide-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 1. 外层容器：负责定位 */
.btn-wrap {
  position: fixed;
  bottom: 150rpx;
  right: 30rpx;
  z-index: 999;
}

/* 2. 客服浮动按钮 */
.kefu-btn {
  background-color: #0f5e35 !important;
  width: 100rpx !important;
  height: 100rpx !important;
  padding: 0 !important;
  margin: 0;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 94, 53, 0.4);
}
.kefu-btn::after { border: none; }
.kefu-btn image {
  width: 100%;
  height: 100%;
  display: block;
}
.kefu-btn:active {
  transform: scale(1.2);
  transition: transform 0.15s ease;
}

.home-body {
  padding: 8rpx 32rpx 160rpx;
}

.hero {
  margin: 8rpx 0 28rpx;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 44rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(196, 160, 106, 0.35), transparent 36%),
    linear-gradient(155deg, #1b4639 0%, #2d6a55 58%, #3d7a62 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.hero .kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.75;
  font-weight: 500;
}
.hero .h1 {
  color: #fff;
  font-size: 48rpx;
  margin-top: 0;
  line-height: 1.25;
}
.hero .kicker + .h1 { margin-top: 12rpx; }
.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.78;
  line-height: 1.55;
  max-width: 78%;
}
.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.route-card { padding: 36rpx 32rpx 32rpx; }
.go-book { margin-top: 28rpx; }

.guide-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.guide-card {
  flex: 1;
  min-width: 0;
  background: #eef6f1;
  border-radius: 28rpx;
  padding: 24rpx 18rpx 20rpx;
  box-sizing: border-box;
  position: relative;
}
.guide-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 110rpx;
}
.guide-txt { flex: 1; min-width: 0; }
.guide-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e4d3e;
  line-height: 1.25;
}
.guide-s {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6b8a7a;
  line-height: 1.35;
}
.guide-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  color: #fff;
}
.guide-ico-ops { background: linear-gradient(145deg, #f0b35a, #e89a2e); }
.guide-ico-safe { background: linear-gradient(145deg, #6dca8f, #3aa86a); }
.guide-ico-faq { background: linear-gradient(145deg, #5bbf8a, #2f9d66); }
.guide-go {
  margin-top: 18rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #1e4d3e;
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.city-pair {
  display: flex;
  align-items: center;
}
.city-col { flex: 1; min-width: 0; }
.city-col.right { text-align: right; }
.city-col .lbl {
  font-size: 22rpx;
  color: #7a847e;
  letter-spacing: 2rpx;
}
.city-name {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -0.8rpx;
  line-height: 1.2;
}
.swap {
  width: 72rpx;
  height: 72rpx;
  margin: 0 12rpx;
  border-radius: 50%;
  background: #e7f0eb;
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.trust {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.trust-item {
  flex: 1;
  margin-bottom: 0;
  padding: 24rpx 12rpx;
  text-align: center;
}
.trust-ico {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 8rpx;
  border-radius: 16rpx;
  background: #e7f0eb;
  color: #2d6a55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.trust .t { font-size: 24rpx; font-weight: 600; }
.trust .s { font-size: 20rpx; color: #7a847e; margin-top: 4rpx; }

.svc-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.svc {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #f2f7f4;
  border-radius: 28rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.svc-t { font-size: 26rpx; font-weight: 650; }
.svc-s { font-size: 22rpx; color: #7a847e; margin-top: 8rpx; }

.resume {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
  background: #1e4d3e;
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 24rpx 56rpx rgba(30, 77, 62, 0.32);
  z-index: 20;
}
.resume-txt { flex: 1; font-size: 26rpx; }
.resume-x {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
