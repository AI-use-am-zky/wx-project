.home-swiper {
  width: 100%;
  height: 375rpx;
}
.slide-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 1. 外层容器：负责定位 */
.btn-wrap {
  position: fixed;
  bottom: 150rpx;
  right: 30rpx;
  z-index: 999;
}

/* 2. 客服浮动按钮 */
.kefu-btn {
  background-color: #0f5e35 !important;
  width: 100rpx !important;
  height: 100rpx !important;
  padding: 0 !important;
  margin: 0;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 94, 53, 0.4);
}
.kefu-btn::after { border: none; }
.kefu-btn image {
  width: 100%;
  height: 100%;
  display: block;
}
.kefu-btn:active {
  transform: scale(1.2);
  transition: transform 0.15s ease;
}

.home-body {
  padding: 8rpx 32rpx 160rpx;
}

.hero {
  margin: 8rpx 0 28rpx;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 44rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(196, 160, 106, 0.35), transparent 36%),
    linear-gradient(155deg, #1b4639 0%, #2d6a55 58%, #3d7a62 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.hero .kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.75;
  font-weight: 500;
}
.hero .h1 {
  color: #fff;
  font-size: 48rpx;
  margin-top: 0;
  line-height: 1.25;
}
.hero .kicker + .h1 { margin-top: 12rpx; }
.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.78;
  line-height: 1.55;
  max-width: 78%;
}
.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.route-card {
  padding: 28rpx 24rpx 28rpx;
  background: linear-gradient(180deg, #f3fff6 0%, #fff 42%);
}
.addr { position: relative; }
.rail {
  position: absolute;
  left: 18rpx;
  top: 52rpx;
  bottom: 52rpx;
  border-left: 2rpx dashed #d5ddd8;
}
.addr-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}
.pin {
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.pin-from { background: #1a1a1a; }
.pin-to { background: #e23b32; }
.addr-main { flex: 1; min-width: 0; padding: 0 16rpx; }
.addr-top { display: flex; align-items: baseline; gap: 16rpx; }
.addr-name { font-size: 34rpx; font-weight: 700; color: #15241e; }
.addr-phone { font-size: 30rpx; font-weight: 650; color: #15241e; }
.addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6d756f;
  line-height: 1.45;
}
.addr-detail.placeholder { color: #b0b6b2; }
.addr-book {
  width: 88rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #15241e;
  font-size: 22rpx;
  font-weight: 600;
}
.book-ico {
  width: 52rpx;
  height: 60rpx;
  border-radius: 8rpx 14rpx 14rpx 8rpx;
  background: linear-gradient(180deg, #c6f56a, #7ed957);
  position: relative;
  box-shadow: 0 6rpx 12rpx rgba(90, 170, 50, 0.25);
}
.book-ico::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.85);
}
.go-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-left: 8rpx;
}
.go-book {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3dcf78 0%, #b6f56a 100%);
  color: #143024;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-kefu {
  width: 96rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #5c6560;
}
.card-kefu::after { border: none; }
.card-kefu image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
}

.guide-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.guide-card {
  flex: 1;
  min-width: 0;
  background: #eef6f1;
  border-radius: 28rpx;
  padding: 24rpx 18rpx 20rpx;
  box-sizing: border-box;
  position: relative;
}
.guide-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 110rpx;
}
.guide-txt { flex: 1; min-width: 0; }
.guide-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e4d3e;
  line-height: 1.25;
}
.guide-s {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6b8a7a;
  line-height: 1.35;
}
.guide-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  color: #fff;
}
.guide-ico-ops { background: linear-gradient(145deg, #f0b35a, #e89a2e); }
.guide-ico-safe { background: linear-gradient(145deg, #6dca8f, #3aa86a); }
.guide-ico-faq { background: linear-gradient(145deg, #5bbf8a, #2f9d66); }
.guide-go {
  margin-top: 18rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #1e4d3e;
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.trust {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.trust-item {
  flex: 1;
  margin-bottom: 0;
  padding: 24rpx 12rpx;
  text-align: center;
}
.trust-ico {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 8rpx;
  border-radius: 16rpx;
  background: #e7f0eb;
  color: #2d6a55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.trust .t { font-size: 24rpx; font-weight: 600; }
.trust .s { font-size: 20rpx; color: #7a847e; margin-top: 4rpx; }

.promo {
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #cbee86;
}
.promo-head {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx 8rpx 36rpx;
}
.promo-copy { flex: 1; min-width: 0; }
.promo-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1c1c1c;
  line-height: 1.25;
}
.promo-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4d5c3a;
}
.promo-cat {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
}
.promo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 20rpx 20rpx;
}
.promo-cell {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 16rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
}
.promo-cell image {
  width: 168rpx;
  height: 148rpx;
}
.promo-t {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.3;
}
.promo-s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8d9488;
  line-height: 1.35;
}
.promo-foot {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #3d7a38;
  background-color: #e7f6c4;
  background-image: linear-gradient(90deg, #e4f4bf 0 16rpx, #f4ef9a 16rpx 32rpx);
  background-size: 32rpx 100%;
}

.resume {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
  background: #1e4d3e;
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 24rpx 56rpx rgba(30, 77, 62, 0.32);
  z-index: 20;
}
.resume-txt { flex: 1; font-size: 26rpx; }
.resume-x {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
