<nav-bar title="宠途空运" />
<!-- 轮播图容器 -->
<swiper class="home-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" duration="500" circular="{{true}}">
  <swiper-item wx:for="{{swiperList}}" wx:key="id">
    <image src="{{item.url}}" class="slide-image" mode="aspectFill" />
  </swiper-item>
</swiper>

<view class="btn-wrap">
  <button class="kefu-btn" open-type="contact" plain="true">
    <image src="/images/kefu.png"></image>
  </button>
</view>
<view class="home-body">
  <view class="hero">
    <view class="kicker">PET AIR · DOOR TO DOOR</view>
    <view class="h1">把爱宠，安全送到</view>
    <view class="h1">下一座城</view>
    <view class="hero-sub">只做空运门到门。填好寄收地址再估价，全程不跳转其他快递小程序。</view>
    <view class="hero-chips">
      <text class="chip chip-white">一单一只宠物</text>
      <text class="chip chip-white">上门取件</text>
      <text class="chip chip-white">承运询价</text>
    </view>
  </view>

  <view class="card route-card">
    <view class="addr">
      <view class="rail"></view>
      <view class="addr-row">
        <view class="pin pin-from">寄</view>
        <view class="addr-main" bindtap="editWho" data-who="sender">
          <view class="addr-top">
            <text class="addr-name">{{senderName}}</text>
            <text class="addr-phone" wx:if="{{senderPhone}}">{{senderPhone}}</text>
          </view>
          <view class="addr-detail {{senderLine?'':'placeholder'}}">{{senderLine || '请选择寄件地址'}}</view>
        </view>
        <view class="addr-book" catchtap="openBook" data-who="sender">
          <view class="book-ico"></view>
          <text>地址簿</text>
        </view>
      </view>
      <view class="addr-row">
        <view class="pin pin-to">收</view>
        <view class="addr-main" bindtap="editWho" data-who="receiver">
          <view class="addr-top">
            <text class="addr-name">{{receiverName}}</text>
            <text class="addr-phone" wx:if="{{receiverPhone}}">{{receiverPhone}}</text>
          </view>
          <view class="addr-detail {{receiverLine?'':'placeholder'}}">{{receiverLine || '请选择收件地址'}}</view>
        </view>
        <view class="addr-book" catchtap="openBook" data-who="receiver">
          <view class="book-ico"></view>
          <text>地址簿</text>
        </view>
      </view>
    </view>
    <view class="go-row">
      <view class="go-book" bindtap="goBook">去下单</view>
      <button class="card-kefu" open-type="contact">
        <image src="/images/kefu.png" mode="aspectFill"></image>
        <text>客服</text>
      </button>
    </view>
  </view>

  <view class="guide-row">
    <view class="guide-card" bindtap="goGuide" data-url="/pages/guide/ops">
      <view class="guide-top">
        <view class="guide-txt">
          <view class="guide-t">操作指南</view>
          <view class="guide-s">如何下单？</view>
        </view>
        <view class="guide-ico guide-ico-ops">单</view>
      </view>
      <view class="guide-go">›</view>
    </view>
    <view class="guide-card" bindtap="goGuide" data-url="/pages/guide/guarantee">
      <view class="guide-top">
        <view class="guide-txt">
          <view class="guide-t">服务保障</view>
          <view class="guide-s">安全如何保障？</view>
        </view>
        <view class="guide-ico guide-ico-safe">保</view>
      </view>
      <view class="guide-go">›</view>
    </view>
    <view class="guide-card" bindtap="goGuide" data-url="/pages/guide/faq">
      <view class="guide-top">
        <view class="guide-txt">
          <view class="guide-t">常见问题</view>
          <view class="guide-s">更多注意事项</view>
        </view>
        <view class="guide-ico guide-ico-faq">问</view>
      </view>
      <view class="guide-go">›</view>
    </view>
  </view>

  <view class="trust">
    <view class="card trust-item">
      <view class="trust-ico">门</view>
      <view class="t">门到门</view>
      <view class="s">取件到派送</view>
    </view>
    <view class="card trust-item">
      <view class="trust-ico">保</view>
      <view class="t">可保价</view>
      <view class="s">声明价值</view>
    </view>
    <view class="card trust-item">
      <view class="trust-ico">服</view>
      <view class="t">真人客服</view>
      <view class="s">09:00–21:00</view>
    </view>
  </view>

  <view class="promo">
    <view class="promo-head">
      <view class="promo-copy">
        <view class="promo-title">宠物托运选宠途</view>
        <view class="promo-sub">专业可靠 | 全程护航</view>
      </view>
      <image class="promo-cat" src="/images/promo-cat.jpg" mode="aspectFit" />
    </view>
    <view class="promo-grid">
      <view class="promo-cell">
        <image src="/images/promo-plane.jpg" mode="aspectFit" />
        <view class="promo-t">24h必达</view>
        <view class="promo-s">专享资源，航空直达</view>
      </view>
      <view class="promo-cell">
        <image src="/images/promo-dog.jpg" mode="aspectFit" />
        <view class="promo-t">全链路追踪</view>
        <view class="promo-s">全程保障，物流实时更新</view>
      </view>
      <view class="promo-cell">
        <image src="/images/promo-price.jpg" mode="aspectFit" />
        <view class="promo-t">透明价格</view>
        <view class="promo-s">实时报价，清晰可查</view>
      </view>
      <view class="promo-cell">
        <image src="/images/promo-service.jpg" mode="aspectFit" />
        <view class="promo-t">专属客服</view>
        <view class="promo-s">1对1服务，即时沟通</view>
      </view>
    </view>
    <view class="promo-foot">
      <text>MY ADORABLE PET</text>
      <text>MY SUNSHINE</text>
    </view>
  </view>

  <view class="card">
    <view class="h2">服务说明</view>
    <view class="sub" style="margin-top:16rpx">上门取件日期由你选，具体时段和航班按承运方可约时间安排。报价含门到门空运，支付给本服务商，不跳转其他小程序。</view>
  </view>
</view>

<view class="resume" wx:if="{{resumeText}}" catchtap="resumeBook">
  <view class="resume-txt">{{resumeText}}</view>
  <view class="resume-x" catchtap="closeResume">×</view>
</view>

