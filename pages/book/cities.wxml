<view class="safe-b">
  <view class="card">
    <view class="steps">
      <view class="step on"><view class="n">1</view>城市</view>
      <view class="step"><view class="n">2</view>地址</view>
      <view class="step"><view class="n">3</view>估价</view>
      <view class="step"><view class="n">4</view>资料</view>
      <view class="step"><view class="n">5</view>支付</view>
    </view>
  </view>

  <view class="card" wx:if="{{!role || role==='from'}}">
    <view class="row-plain">
      <view>
        <view class="faint">出发城市</view>
        <view class="h2 mt-8">{{role==='from' ? '选择寄出地' : '选择寄出地'}}</view>
      </view>
      <text class="chip">跟承运方可运城市</text>
    </view>
    <view class="city-grid">
      <view
        wx:for="{{cities}}"
        wx:key="code"
        class="city {{fromCode===item.code?'on':''}}"
        data-role="from"
        data-code="{{item.code}}"
        bindtap="pick"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{!role || role==='to'}}">
    <view class="faint">到达城市</view>
    <view class="h2 mt-8">选择目的地</view>
    <view class="city-grid">
      <view
        wx:for="{{cities}}"
        wx:key="code"
        class="city {{toCode===item.code?'on':''}}"
        data-role="to"
        data-code="{{item.code}}"
        bindtap="pick"
      >{{item.name}}</view>
    </view>
  </view>
</view>
<view class="footer-bar" wx:if="{{!role}}">
  <view class="btn" bindtap="next">下一步：填写地址</view>
</view>

