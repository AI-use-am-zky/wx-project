<view class="safe">
  <view class="card">
    <view class="muted">种类</view>
    <picker range="{{speciesNames}}" bindchange="onSpecies">
      <view class="row"><text>{{speciesName || '请选择'}}</text><text class="muted">选择</text></view>
    </picker>
    <view class="muted">品种</view>
    <picker range="{{breedNames}}" bindchange="onBreed">
      <view class="row"><text>{{breed || '请选择'}}</text><text class="muted">选择</text></view>
    </picker>
    <view class="muted">宠物姓名（选填）</view>
    <input placeholder="例如 奶茶" value="{{petName}}" bindinput="onPetName" />
    <view class="muted" style="margin-top:16rpx">宠物注意事项（选填）</view>
    <textarea class="area" placeholder="例如 易应激、需温热食物、分离焦虑等" value="{{petNote}}" bindinput="onPetNote" auto-height />
    <view class="muted" style="margin-top:16rpx">体重（kg）</view>
    <input type="digit" placeholder="例如 4.5" value="{{weightKg}}" bindinput="onWeight" />
    <view class="muted" style="margin-top:16rpx">上门取件日（航班由承运方排）</view>
    <picker mode="date" start="{{minDate}}" bindchange="onDate">
      <view class="row"><text>{{pickupDate || '请选择日期'}}</text><text class="muted">日历</text></view>
    </picker>
  </view>
  <view class="btn" bindtap="quote">估价</view>
</view>
