.photos { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:16rpx; }
.ph, .add { width:160rpx; height:160rpx; background:#f3f6f4; border-radius:12rpx; }
.add { display:flex; align-items:center; justify-content:center; font-size:48rpx; color:#2d5a4a; }
input { border-bottom:1rpx solid #eee; padding:16rpx 0; }
.hint {
  background: #fff7ed;
  color: #9a3412;
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.shot-canvas {
  width: 240px;
  height: 240px;
  position: fixed;
  left: -9999px;
  top: -9999px;
}
.cam-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #000;
  z-index: 99;
}
.cam { width: 100%; height: 70%; }
.cam-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 40rpx 24rpx;
}
.cam-btn {
  background: #2d5a4a;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}
.cam-btn.ghost { background: #444; }
