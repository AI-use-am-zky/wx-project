.hint {
  background: #fff7ed;
  color: #9a3412;
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.shot-canvas {
  width: 240px;
  height: 240px;
  position: fixed;
  left: -9999px;
  top: -9999px;
}
.cam-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #000;
  z-index: 99;
}
.cam { width: 100%; height: 70%; }
.cam-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 40rpx 24rpx;
}
.cam-btn {
  background: #1e4d3e;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}
.cam-btn.ghost { background: #444; }
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, #f3efe8 30%);
  z-index: 10;
}
.footer-bar .btn { margin-top: 0; }
