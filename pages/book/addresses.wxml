<view class="safe-b">
  <view class="card">
    <view class="row-plain mb-8">
      <view class="h2">寄件人 · 上门取件</view>
      <text class="link" data-who="sender" bindtap="paste">粘贴识别</text>
    </view>
    <view class="locked">{{fromLabel || '出发城市'}}</view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input placeholder="开门联系人" value="{{sender.name}}" data-who="sender" data-k="name" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input placeholder="11位手机号" type="number" maxlength="11" value="{{sender.phone}}" data-who="sender" data-k="phone" bindinput="onField" />
      <view wx:if="{{senderPhoneErr}}" class="err">{{senderPhoneErr}}</view>
    </view>
    <view class="field">
      <view class="field-label">区 / 县</view>
      <input placeholder="例如 西湖区" value="{{sender.district}}" data-who="sender" data-k="district" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">详细地址</view>
      <textarea class="area" placeholder="详细地址，可粘贴整段地址自动拆分" value="{{sender.detail}}" data-who="sender" data-k="detail" bindinput="onField" auto-height />
    </view>
  </view>

  <view class="card">
    <view class="row-plain mb-8">
      <view class="h2">收件人 · 上门派送</view>
      <text class="link" data-who="receiver" bindtap="paste">粘贴识别</text>
    </view>
    <view class="locked">{{toLabel || '到达城市'}}</view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input placeholder="开门联系人" value="{{receiver.name}}" data-who="receiver" data-k="name" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input placeholder="11位手机号" type="number" maxlength="11" value="{{receiver.phone}}" data-who="receiver" data-k="phone" bindinput="onField" />
      <view wx:if="{{receiverPhoneErr}}" class="err">{{receiverPhoneErr}}</view>
    </view>
    <view class="field">
      <view class="field-label">区 / 县</view>
      <input placeholder="例如 锦江区" value="{{receiver.district}}" data-who="receiver" data-k="district" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">详细地址</view>
      <textarea class="area" placeholder="详细地址，可粘贴整段地址自动拆分" value="{{receiver.detail}}" data-who="receiver" data-k="detail" bindinput="onField" auto-height />
    </view>
  </view>

  <view class="btn btn-ghost" bindtap="saveBook">保存到地址簿</view>
</view>
<view class="footer-bar">
  <view class="btn" bindtap="next">下一步：宠物与取件日</view>
</view>

