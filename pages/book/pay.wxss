.agree {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.phone-btn {
  width: auto;
  margin: 0 0 24rpx;
}
.paybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -8rpx 32rpx rgba(21, 36, 30, 0.06);
}
.pay-btn {
  margin: 0;
  min-width: 260rpx;
  padding: 20rpx 40rpx;
}
