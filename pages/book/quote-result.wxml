<view class="safe">
  <view class="card">
    <view class="muted">{{quote.quoteSource === 'sf' ? '承运询价 + 服务费' : '价表兜底（询价暂不可用）'}}</view>
    <view class="row" wx:for="{{quote.lines}}" wx:key="key">
      <text>{{item.name}}</text>
      <text>¥{{item.yuan}}</text>
    </view>
    <view class="row">
      <text>小计（门到门空运）</text>
      <text class="price">¥{{freightYuan}}</text>
    </view>
  </view>
  <view class="card">
    <view>加购</view>
    <view class="row" bindtap="toggleCrate">
      <text>购买航空箱（不租）</text>
      <text>{{crateOn ? '已选' : '自备'}}</text>
    </view>
    <picker wx:if="{{crateOn}}" range="{{crateNames}}" bindchange="onCrate">
      <view class="row"><text>{{crateLabel || '选择箱型'}}</text><text class="muted">¥{{crateYuan}}</text></view>
    </picker>
    <view class="row" bindtap="toggleAgency">
      <text>代办检疫</text>
      <text>{{agencyOn ? '¥200.00' : '自备证明'}}</text>
    </view>
    <view class="row" bindtap="toggleInsure">
      <text>顺丰保价</text>
      <text>{{insureOn ? '已选' : '不保价'}}</text>
    </view>
    <input wx:if="{{insureOn}}" type="number" placeholder="声明价值（元）" value="{{declaredYuan}}" bindinput="onDeclared" />
  </view>
  <view class="card">
    <view class="row">
      <text>应付</text>
      <text class="price">¥{{totalYuan}}</text>
    </view>
  </view>
  <view class="btn" bindtap="next">去补资料并支付</view>
</view>
