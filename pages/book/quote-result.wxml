<view class="safe" style="padding-bottom: 180rpx;">
  <view class="card quote-hero">
    <text class="chip chip-gold">{{quote.quoteSource === 'sf' ? '承运询价 + 服务费' : '价表兜底（询价暂不可用）'}}</text>
    <view class="faint mt-12">{{routeLine}}</view>
    <view class="mt-12">
      <text class="yen">¥</text><text class="num">{{totalYuan}}</text>
    </view>
    <view class="sub">应付（门到门），可加购箱 / 检疫 / 保价</view>
  </view>

  <view class="card">
    <view class="h2 mb-8">费用拆分</view>
    <view class="info-kv" wx:for="{{quote.lines}}" wx:key="key">
      <text class="k">{{item.name}}</text>
      <text>¥{{item.yuan}}</text>
    </view>
    <view class="info-kv">
      <text>小计（门到门空运）</text>
      <text class="price">¥{{freightYuan}}</text>
    </view>
  </view>

  <view class="card">
    <view class="h2 mb-8">加购</view>
    <view class="addon">
      <view class="txt">
        <view class="h2" style="font-size:28rpx">购买航空箱</view>
        <view class="sub">不租箱。关闭则为自备并在下一步上传箱照。</view>
        <view class="crate-opt" wx:if="{{crateOn}}">
          <view
            wx:for="{{crates}}"
            wx:key="id"
            class="crate-chip {{item.id===crateSkuId?'on':''}}"
            data-id="{{item.id}}"
            bindtap="pickCrate"
          >{{item.name}} · ¥{{item.yuan}}</view>
        </view>
      </view>
      <view class="addon-side">
        <view class="faint">{{crateOn ? (crateLabel || '请选箱型') : '自备'}}</view>
        <view class="switch {{crateOn?'on':''}}" bindtap="toggleCrate"></view>
      </view>
    </view>
    <view class="addon">
      <view class="txt">
        <view class="h2" style="font-size:28rpx">代办检疫</view>
        <view class="sub">代办 ¥200。关闭则需自备检疫证明。</view>
      </view>
      <view class="addon-side">
        <view class="faint">{{agencyOn ? '¥200.00' : '自备证明'}}</view>
        <view class="switch {{agencyOn?'on':''}}" bindtap="toggleAgency"></view>
      </view>
    </view>
    <view class="addon">
      <view class="txt">
        <view class="h2" style="font-size:28rpx">顺丰保价</view>
        <view class="sub">按声明价值约 1% 计费，最低 ¥1。</view>
        <view class="field" wx:if="{{insureOn}}" style="padding-top:16rpx">
          <view class="field-label">声明价值（元）</view>
          <input type="number" placeholder="例如 3000" value="{{declaredYuan}}" bindinput="onDeclared" />
        </view>
      </view>
      <view class="addon-side">
        <view class="faint">{{insureOn ? '已选' : '不保价'}}</view>
        <view class="switch {{insureOn?'on':''}}" bindtap="toggleInsure"></view>
      </view>
    </view>
  </view>
</view>
<view class="paybar">
  <view>
    <view class="faint">应付</view>
    <view class="price" style="font-size:44rpx">¥{{totalYuan}}</view>
  </view>
  <view class="btn pay-btn" bindtap="next">去补资料</view>
</view>

