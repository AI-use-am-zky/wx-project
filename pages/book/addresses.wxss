input { border-bottom: 1rpx solid #eee; padding: 18rpx 0; }
.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-weight: 600;
}
.link { color: #2d5a4a; font-size: 24rpx; font-weight: 400; }
.err { color: #c2410c; font-size: 22rpx; margin-top: 6rpx; }
.locked {
  margin: 8rpx 0 4rpx;
  padding: 16rpx 20rpx;
  background: #eef4f1;
  color: #2d5a4a;
  border-radius: 12rpx;
  font-weight: 600;
}
.area {
  margin-top: 12rpx;
  min-height: 120rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
