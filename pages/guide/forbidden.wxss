page { background: #f3efe8; color: #15241e; }
.page { padding: 24rpx 28rpx 48rpx; }
.lead {
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d5248;
  margin-bottom: 20rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 12rpx;
  margin-bottom: 20rpx;
}
.h { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.item {
  position: relative;
  padding: 18rpx 0 18rpx 28rpx;
  border-top: 1rpx solid #f0ece6;
  font-size: 28rpx;
  line-height: 1.5;
  color: #15241e;
}
.item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 32rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1e4d3e;
}
.foot {
  font-size: 24rpx;
  color: #7a847e;
  line-height: 1.55;
}
