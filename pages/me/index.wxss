.me-page { min-height: 100vh; background: #f3f1ed; }
.hero {
  background: linear-gradient(180deg, #2d5a4a 0%, #3a6d5a 70%, #f3f1ed 100%);
  padding-bottom: 48rpx;
}
.nav { display: flex; align-items: flex-end; padding: 0 28rpx 8rpx; }
.nav-icons { display: flex; gap: 24rpx; }
.ico {
  color: #fff;
  font-size: 24rpx;
  background: rgba(255,255,255,.16);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}
.profile {
  margin: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #e8f0ec;
  color: #2d5a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}
.profile-txt .name { font-size: 34rpx; font-weight: 600; }
.body { padding: 8rpx 28rpx 48rpx; }
.sec-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-weight: 600;
}
.link { color: #8a918c; font-size: 24rpx; font-weight: 400; }
.grid4 {
  display: flex;
  padding-top: 12rpx;
}
.gitem {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #3a4440;
  background: transparent;
  border: none;
  line-height: 1.4;
  padding: 8rpx 0;
}
.gico {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 8rpx;
  border-radius: 20rpx;
  background: #eef4f1;
  color: #2d5a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  position: relative;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #e54d42;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.row-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hours { text-align: center; color: #9aa39d; font-size: 22rpx; margin-top: 16rpx; }
.contact-btn::after { border: none; }
.contact-btn { margin: 0; }
