.me-page { min-height: 100vh; background: #f3efe8; }
.me-hero {
  background: linear-gradient(180deg, #1b4639 0%, #2f6d58 62%, #f3efe8 100%);
  padding: 0 32rpx 56rpx;
}
.nav {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 0 8rpx;
}
.nav-icons { display: flex; gap: 16rpx; }
.ico {
  color: #fff;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}
.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(21, 36, 30, 0.06);
}
.ava {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #d8efe6, #b7d4c6);
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.grow { flex: 1; min-width: 0; }
.profile .name { font-size: 36rpx; font-weight: 650; }
.chev { color: #a3aba6; font-size: 40rpx; line-height: 1; }
.body { padding: 0 32rpx 48rpx; }
.grid4 {
  display: flex;
  padding-top: 16rpx;
}
.gitem {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2c3a34;
  background: transparent;
  border: none;
  line-height: 1.4;
  padding: 16rpx 0;
}
.gico {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 28rpx;
  background: #e7f0eb;
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 650;
  position: relative;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #e24c3f;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-weight: 700;
}
.row-link {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.row-link .gico { margin: 0; }
