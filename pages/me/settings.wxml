<view class="safe">
  <view class="card">
    <view class="pick-row" bindtap="go" data-url="/pages/me/invoice">
      <text>电子发票</text>
      <text class="muted">签收后开具 ›</text>
    </view>
    <view class="pick-row" bindtap="go" data-url="/pages/legal/agreement">
      <text>运输服务协议</text>
      <text class="muted">v1 ›</text>
    </view>
    <view class="pick-row" bindtap="about">
      <text>关于宠途空运</text>
      <text class="muted">v0.1</text>
    </view>
    <view wx:if="{{showSfDebug}}" class="pick-row" bindtap="go" data-url="/pages/debug/sf-recommend">
      <text>顺丰询价联调</text>
      <text class="muted">产品推荐 ›</text>
    </view>
  </view>
  <view class="btn btn-ghost" bindtap="logout">退出登录</view>
</view>

