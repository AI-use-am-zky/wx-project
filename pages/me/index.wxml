<view class="me-page" style="padding-top: {{padTop}}px;">
  <view class="me-hero" style="padding-top: {{navPad}}px;">
    <view class="nav" style="height: {{navH}}px;">
      <view class="nav-back" bindtap="goBack">‹</view>
      <view class="nav-icons">
        <view class="ico" bindtap="goMsg">消息</view>
        <view class="ico" bindtap="goSet">设置</view>
      </view>
    </view>
    <view class="profile" bindtap="tapUser">
      <image wx:if="{{loggedIn && avatarUrl}}" class="ava-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="ava">{{loggedIn ? '途' : '登'}}</view>
      <view class="grow">
        <view class="name">{{loggedIn ? (nickName || phone || '已登录') : '点击登录'}}</view>
        <view class="sub">
          {{loggedIn ? (needProfile ? '完善微信头像和昵称' : '微信账号已关联 · 点击管理资料') : '登录后管理订单与资料'}}
        </view>
      </view>
      <view class="chev">›</view>
    </view>
  </view>

  <view class="body">
    <view class="card">
      <view class="row-plain">
        <view class="h2">我的订单</view>
        <text class="link" bindtap="allOrders">查看全部 ›</text>
      </view>
      <view class="grid4">
        <view class="gitem" bindtap="goTab" data-tab="pending">
          <view class="gico">
            付
            <view wx:if="{{badges.pending}}" class="badge">{{badges.pending}}</view>
          </view>
          待付款
        </view>
        <view class="gitem" bindtap="goTab" data-tab="transit">
          <view class="gico">
            运
            <view wx:if="{{badges.transit}}" class="badge">{{badges.transit}}</view>
          </view>
          出行中
        </view>
        <view class="gitem" bindtap="goTab" data-tab="done">
          <view class="gico">
            完
            <view wx:if="{{badges.done}}" class="badge">{{badges.done}}</view>
          </view>
          已完成
        </view>
        <view class="gitem" bindtap="goTab" data-tab="cancelled">
          <view class="gico">
            消
            <view wx:if="{{badges.cancelled}}" class="badge">{{badges.cancelled}}</view>
          </view>
          已取消
        </view>
      </view>
    </view>

    <view class="card row-link" bindtap="goPage" data-url="/pages/me/pets">
      <view class="gico">宠</view>
      <view class="grow">
        <view class="h2" style="font-size:30rpx">我的宠物</view>
        <view class="faint">维护档案，下单时可直接选用</view>
      </view>
      <text class="faint">›</text>
    </view>

    <view class="card">
      <view class="h2">更多服务</view>
      <view class="grid4">
        <view class="gitem" bindtap="goPage" data-url="/pages/me/addresses?title=地址管理">
          <view class="gico">址</view>
          地址管理
        </view>
        <view class="gitem" bindtap="goPage" data-url="/pages/me/coupons">
          <view class="gico">券</view>
          红包卡券
        </view>
        <view class="gitem" bindtap="goPage" data-url="/pages/me/addresses?title=常用联系人">
          <view class="gico">联</view>
          常用联系人
        </view>
        <view class="gitem" bindtap="goPage" data-url="/pages/me/docs">
          <view class="gico">证</view>
          检疫资料
        </view>
      </view>
    </view>

    <view class="card">
      <view class="h2">其他</view>
      <view class="grid4">
        <view class="gitem" bindtap="goPage" data-url="/pages/me/invoice">
          <view class="gico">票</view>
          电子发票
        </view>
        <view class="gitem" bindtap="goPage" data-url="/pages/legal/agreement">
          <view class="gico">约</view>
          运输协议
        </view>
      </view>
    </view>
  </view>
</view>
