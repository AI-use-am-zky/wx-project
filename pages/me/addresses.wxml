<view class="tabs">
  <view class="tab on">寄中国内地<view class="tab-line"></view></view>
  <view class="tab" bindtap="soon">寄中国港澳台</view>
  <view class="tab" bindtap="soon">寄国际</view>
</view>

<view class="search">
  <text class="search-ico">搜</text>
  <input
    class="search-input"
    placeholder="请输入姓名/手机号/公司名称"
    placeholder-class="ph"
    value="{{keyword}}"
    bindinput="onSearch"
  />
</view>

<view class="list">
  <view class="empty" wx:if="{{!shown.length && !showForm}}">暂无保存的地址</view>

  <block wx:if="{{!compose}}">
  <view class="card" wx:for="{{shown}}" wx:key="id" data-index="{{index}}" bindtap="choose">
    <view class="who">
      <text class="name">{{item.name}}</text>
      <text class="phone">{{item.phoneMask}}</text>
    </view>
    <view class="addr">{{item.line}}</view>
    <view class="ops" catchtap="noop">
      <view class="op" catchtap="share" data-index="{{index}}">分享</view>
      <view class="op" catchtap="edit" data-index="{{index}}">编辑</view>
      <view class="op danger" catchtap="remove" data-index="{{index}}">删除</view>
    </view>
  </view>
  </block>

  <view class="card form" wx:if="{{showForm}}">
    <view class="form-title">{{editingId ? '编辑地址' : '新增地址'}}</view>
    <view class="paste">
      <textarea
        class="paste-input"
        placeholder="粘贴整段地址，自动识别姓名、手机和地址"
        placeholder-class="ph"
        value="{{pasteText}}"
        bindinput="onPaste"
        auto-height
        maxlength="300"
      />
    </view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input placeholder="开门联系人" value="{{form.name}}" data-k="name" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">手机</view>
      <input placeholder="11 位手机号" type="number" maxlength="11" value="{{form.phone}}" data-k="phone" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">省</view>
      <input placeholder="例如 浙江省" value="{{form.province}}" data-k="province" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">市</view>
      <input placeholder="例如 杭州市" value="{{form.city}}" data-k="city" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">区/县</view>
      <input placeholder="例如 西湖区" value="{{form.district}}" data-k="district" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">详细门牌</view>
      <input placeholder="路名、楼号、室" value="{{form.detail}}" data-k="detail" bindinput="onF" />
    </view>
    <view class="form-actions">
      <view class="ghost" bindtap="closeForm">取消</view>
      <view class="btn save" bindtap="save">保存</view>
    </view>
  </view>
</view>

<view class="footer" wx:if="{{!showForm}}">
  <view class="manage" bindtap="hintManage">管理</view>
  <view class="add" bindtap="openForm">新增地址</view>
</view>
