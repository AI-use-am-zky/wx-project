<view class="safe-b">
  <view class="empty card" wx:if="{{!list.length && !showForm}}">
    <view class="h2">暂无保存的地址</view>
    <view class="sub mt-8">可在下单时填写并保存到地址簿。</view>
  </view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row-plain">
      <view class="grow">
        <view class="h2" style="font-size:30rpx">{{item.name}} {{item.phone}}</view>
        <view class="sub mt-8">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
      </view>
    </view>
  </view>
  <view class="card" wx:if="{{showForm}}">
    <view class="h2 mb-8">新增地址</view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input placeholder="开门联系人" value="{{form.name}}" data-k="name" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">手机</view>
      <input placeholder="11 位手机号" value="{{form.phone}}" data-k="phone" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">省</view>
      <input placeholder="例如 浙江省" value="{{form.province}}" data-k="province" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">市</view>
      <input placeholder="例如 杭州市" value="{{form.city}}" data-k="city" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">区</view>
      <input placeholder="例如 西湖区" value="{{form.district}}" data-k="district" bindinput="onF" />
    </view>
    <view class="field">
      <view class="field-label">详细门牌</view>
      <input placeholder="路名、楼号、室" value="{{form.detail}}" data-k="detail" bindinput="onF" />
    </view>
    <view class="btn" bindtap="save">保存</view>
  </view>
</view>
<view class="footer-bar" wx:if="{{!showForm}}">
  <view class="btn" bindtap="openForm">新增地址</view>
</view>

