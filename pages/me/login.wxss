.page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx 80rpx;
  box-sizing: border-box;
}
.logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  background: #1e4d3e;
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2a24;
}
.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a847e;
}
.wx-btn {
  margin-top: 120rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #1e4d3e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 650;
}
.wx-btn::after { border: none; }
.agree {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #7a847e;
  padding-top: 48rpx;
}
.box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #c5cdc8;
  margin-right: 12rpx;
  box-sizing: border-box;
}
.box.on {
  background: #1e4d3e;
  border-color: #1e4d3e;
  box-shadow: inset 0 0 0 6rpx #fff;
}
.link { color: #1e4d3e; }
.err {
  margin-top: 32rpx;
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fff4f0;
  color: #a33b2b;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}
