.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #1e4d3e;
  color: #fff;
  font-size: 26rpx;
}
.tab.dim { background: #fff; color: #7a847e; }
.coupon {
  display: flex;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  opacity: 0.55;
  box-shadow: 0 16rpx 48rpx rgba(21, 36, 30, 0.06);
}
.left {
  width: 180rpx;
  background: #f6efe3;
  color: #c45a28;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 32rpx 8rpx;
}
.left .yen { font-size: 28rpx; font-weight: 700; }
.left .num { font-size: 56rpx; font-weight: 720; }
.body { flex: 1; padding: 28rpx 24rpx; }
