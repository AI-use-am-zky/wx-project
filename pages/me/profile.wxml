<view class="safe page">
  <view class="card tip">
    <view class="h2">完善头像和昵称</view>
    <view class="sub mt-8">请点头像选择图片，昵称可手动填写，也可使用系统提供的一键填入。</view>
  </view>

  <view class="card form">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <text class="avatar-tip">点击选择头像</text>
    </button>

    <view class="field">
      <text class="label">昵称</text>
      <input
        type="nickname"
        class="nick-input"
        placeholder="点击输入昵称"
        value="{{nickName}}"
        maxlength="32"
        bindblur="onNickBlur"
        bindinput="onNickInput"
      />
    </view>

    <view class="field" wx:if="{{phone}}">
      <text class="label">手机号</text>
      <text class="value">{{phone}}</text>
    </view>
  </view>

  <view class="btn save" bindtap="save">保存并关联</view>
</view>
