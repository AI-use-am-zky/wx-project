<view class="safe">
  <view class="card">
    <view class="field">
      <view class="field-label">宠物名</view>
      <input placeholder="必填" value="{{name}}" bindinput="on" data-k="name" />
    </view>
    <view class="field">
      <view class="field-label">种类</view>
      <input placeholder="猫 / 狗等" value="{{species}}" bindinput="on" data-k="species" />
    </view>
    <view class="field">
      <view class="field-label">品种</view>
      <input placeholder="例如 英国短毛猫" value="{{breed}}" bindinput="on" data-k="breed" />
    </view>
    <view class="field">
      <view class="field-label">体重 kg</view>
      <input placeholder="下单时仍可修改" type="digit" value="{{weightKg}}" bindinput="on" data-k="weightKg" />
    </view>
    <view class="field">
      <view class="field-label">性别</view>
      <input placeholder="公 / 母" value="{{gender}}" bindinput="on" data-k="gender" />
    </view>
    <view class="field">
      <view class="field-label">备注</view>
      <input placeholder="习性、用药等" value="{{note}}" bindinput="on" data-k="note" />
    </view>
  </view>
  <view class="btn" bindtap="save">保存档案</view>
</view>

