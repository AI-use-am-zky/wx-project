page {
  background: #f3efe8;
  color: #15241e;
  font-size: 28rpx;
  line-height: 1.5;
}

.safe {
  padding: 24rpx 32rpx 48rpx;
}
.safe-b {
  padding: 24rpx 32rpx 160rpx;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(21, 36, 30, 0.06);
}

.h1 {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
}
.h2 {
  font-size: 32rpx;
  font-weight: 650;
}
.sub {
  color: #7a847e;
  font-size: 26rpx;
  line-height: 1.55;
}
.muted { color: #7a847e; }
.faint { color: #a3aba6; font-size: 24rpx; }
.link { color: #2d6a55; font-size: 26rpx; }
.grow { flex: 1; min-width: 0; }
.mt-8 { margin-top: 16rpx; }
.mt-12 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 16rpx; }

.price {
  color: #c45a28;
  font-weight: 700;
  font-size: 36rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #e7f0eb;
  color: #1e4d3e;
}
.chip-gold { background: #f6efe3; color: #8a6a3a; }
.chip-white { background: rgba(255, 255, 255, 0.18); color: #fff; }

.st {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.st-pay { background: #fff1e8; color: #c45a28; }
.st-go { background: #e7f4ee; color: #2a9d6e; }
.st-wait { background: #eef3f8; color: #3b82c4; }
.st-done { background: #f0eee9; color: #6b6460; }
.st-cancel { background: #f4f0ee; color: #9a8f8a; }
.st-warn { background: #fff4d8; color: #b58112; }

.btn {
  margin-top: 24rpx;
  background: #1e4d3e;
  color: #fff;
  border-radius: 28rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}
.btn-ghost {
  background: #fff;
  color: #1e4d3e;
  border: 2rpx solid #c5d6cd;
}
.btn-danger {
  background: #fff;
  color: #e24c3f;
  border: 2rpx solid #f3c7c3;
}
.btn-row {
  display: flex;
  gap: 16rpx;
}
.btn-row .btn { flex: 1; margin-top: 0; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ece8e1;
}
.row:last-child { border-bottom: none; }
.row-plain {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ece8e1;
}
.field:last-child { border-bottom: none; }
.field-label,
.field label {
  display: block;
  font-size: 24rpx;
  color: #7a847e;
  margin-bottom: 10rpx;
}
input, textarea, picker {
  width: 100%;
  font-size: 30rpx;
}
.area {
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}

.locked {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #e7f0eb;
  color: #1e4d3e;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin: 8rpx 0 12rpx;
}

.steps {
  display: flex;
}
.step {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #7a847e;
  position: relative;
}
.step .n {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  background: #e7f0eb;
  color: #1e4d3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.step.on .n { background: #1e4d3e; color: #fff; }
.step:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 24rpx;
  left: 62%;
  right: -38%;
  height: 2rpx;
  background: #e0e6e2;
}

.pick-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ece8e1;
}
.pick-row:last-child { border-bottom: none; }

.switch {
  width: 92rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #d8ddd9;
  position: relative;
  flex-shrink: 0;
}
.switch.on { background: #2d6a55; }
.switch::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
}
.switch.on::after { left: 40rpx; }

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  color: #7a847e;
}

.city-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -8rpx 0;
}
.city {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f2f7f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}
.city.on { background: #1e4d3e; color: #fff; }

.quote-hero { text-align: center; padding: 16rpx 0 8rpx; }
.quote-hero .yen {
  font-size: 32rpx;
  color: #c45a28;
  font-weight: 700;
  margin-right: 4rpx;
}
.quote-hero .num {
  font-size: 80rpx;
  font-weight: 720;
  color: #c45a28;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.info-kv {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.info-kv .k { color: #7a847e; }
.info-kv .v { font-weight: 650; text-align: right; max-width: 70%; }

.photos { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.ph, .add {
  width: 152rpx;
  height: 152rpx;
  background: #f2f7f4;
  border-radius: 24rpx;
}
.add {
  border: 2rpx dashed #c9d4ce;
  color: #2d6a55;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-sizing: border-box;
}
.add-plus { font-size: 40rpx; line-height: 1; margin-bottom: 4rpx; }

.tl { position: relative; padding-left: 40rpx; margin-top: 16rpx; }
.tl::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #2d6a55, #e4ebe7);
}
.tl-item { position: relative; padding: 0 0 32rpx; }
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before {
  content: "";
  position: absolute;
  left: -36rpx;
  top: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c5d4cc;
  border: 4rpx solid #fff;
  box-sizing: border-box;
}
.tl-item.on::before { background: #1e4d3e; }
.tl-item .t { font-weight: 650; }
.tl-item .d { color: #7a847e; font-size: 24rpx; margin-top: 6rpx; }

button.reset,
button.phone-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
  border: none;
  text-align: inherit;
  color: inherit;
}
button.reset::after,
button.phone-btn::after,
button.btn::after {
  border: none;
}
