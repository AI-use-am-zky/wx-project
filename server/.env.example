PORT=8787
# 开发：微信模拟器可访问本机；正式环境勿开 mock
WX_MOCK_LOGIN=true
PAY_MOCK=true
SF_MOCK=true
SF_QUOTE_FAIL=false
# 真实询价：SF_ENV=prod，填生产校验码与真实月结卡
# 沙箱演示：SF_ENV=sbox，月结可用 7551234567
SF_ENV=prod
SF_PARTNER_ID=
SF_CHECKWORD=
SF_MONTHLY_CARD=
# 优先产品：专享即日 productCode=T11（expressType=303）
SF_PREFERRED_PRODUCT_CODES=T11

WX_APP_ID=
WX_APP_SECRET=
# 真支付：PAY_MOCK=false，并填商户号、API 密钥、公网回调
WX_MCH_ID=
WX_PAY_KEY=
# 例：https://你的域名/pay/wx-notify （微信服务器必须能访问）
WX_PAY_NOTIFY_URL=
WX_PAY_CLIENT_IP=127.0.0.1
WX_SUBSCRIBE_TPL_PICKUP=
WX_SUBSCRIBE_TPL_ALERT=
WX_SUBSCRIBE_TPL_SIGNED=

ADMIN_PASSWORD=change-me
ADMIN_NOTIFY_WEBHOOK=

# 后定：加价数字，仅作占位
MARKUP_RATE=0.15
MIN_SERVICE_FEE_CENTS=15000
CANCEL_FEE_BEFORE_COLLECT_CENTS=5000
REWEIGH_IGNORE_KG=1
CUSTOMER_SERVICE_PHONE=400-000-0000
TRANSPORT_AGREEMENT_VERSION=v1
