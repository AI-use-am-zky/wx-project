PORT=8787

# ---------- 微信登录 / 支付（仿真 → 生产）----------
# 仿真：true；生产导入后改为 false 并填写下方凭证
WX_MOCK_LOGIN=true
PAY_MOCK=true
WX_APP_ID=
WX_APP_SECRET=
# 仅开发者工具本机。线上服务器保持 false
ALLOW_DEVTOOLS_LOGIN=false
DEVTOOLS_PHONE=13800138000
WX_MCH_ID=
WX_PAY_KEY=
# 例：https://你的域名/pay/wx-notify （微信服务器必须能访问）
WX_PAY_NOTIFY_URL=
WX_PAY_CLIENT_IP=127.0.0.1
WX_SUBSCRIBE_TPL_PICKUP=
WX_SUBSCRIBE_TPL_ALERT=
WX_SUBSCRIBE_TPL_SIGNED=

# ---------- 顺丰（本地 mock / 沙箱 / 生产）----------
# SF_MOCK=true  → 不访问顺丰，用 sf-mock.js
# SF_MOCK=false → 访问开放平台（再由 SF_ENV 选沙箱或生产）
SF_MOCK=false
SF_QUOTE_FAIL=false

# 沙箱联调（当前推荐本地测通下单）：
#   SF_ENV=sbox
#   SF_CHECKWORD=<开放平台「沙箱校验码」>
#   SF_MONTHLY_CARD=7551234567
# 生产导入：
#   SF_ENV=prod
#   SF_CHECKWORD=<开放平台「生产校验码」>
#   SF_MONTHLY_CARD=<真实月结卡号>
SF_ENV=sbox
SF_PARTNER_ID=
SF_CHECKWORD=
SF_MONTHLY_CARD=7551234567
# 仅测试页可切换；逗号分隔。小程序下单仍用上面的 SF_MONTHLY_CARD
# SF_LAB_MONTHLY_CARDS=卡号1,卡号2

# 宠物主路径：专享即日 T11 / expressTypeId=303
SF_PREFERRED_PRODUCT_CODES=T11
SF_EXPRESS_TYPE_ID=303

# 顺丰→你方推送的公网根（不是顺丰下单 API）
# 沙箱可用 cloudflared；生产改为正式 HTTPS 域名，并在开放平台登记完整回调 URL
SF_PUBLIC_BASE_URL=https://your-domain.example.com
SF_WAYBILL_CALLBACK_PATH=/sfexpress/waybills/back

# ---------- 管理端 / 业务种子 ----------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_NOTIFY_WEBHOOK=

MARKUP_RATE=0.15
MIN_SERVICE_FEE_CENTS=15000
CANCEL_FEE_BEFORE_COLLECT_CENTS=5000
REWEIGH_IGNORE_KG=1
CUSTOMER_SERVICE_PHONE=400-000-0000
TRANSPORT_AGREEMENT_VERSION=v1
