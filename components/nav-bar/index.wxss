.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2d5a4a;
}
.nav-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.2;
}
.nav-back {
  position: absolute;
  left: 8rpx;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
